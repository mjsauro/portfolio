# Node
node_modules/
npm-debug.log*
.npm/

# Angular
web/dist/
web/.angular/
/web/tmp/

# Terraform
# .terraform.lock.hcl is deliberately NOT ignored — committing it pins provider
# versions so CI resolves exactly what was validated locally.
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
*.tfvars
!*.tfvars.example
backend.hcl
!backend.hcl.example
infra/.build/

# Editors / OS
.DS_Store
.idea/
*.swp

# Secrets
.env
.env.*
!.env.example
